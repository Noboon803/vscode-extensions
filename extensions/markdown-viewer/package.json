{
  "name": "markdown-viewer",
  "displayName": "Markdown Viewer",
  "description": "ファイルごとに固定され、スクロールも連動せず、コメントを書き込める Markdown プレビュー",
  "version": "0.0.1",
  "publisher": "noboon",
  "private": true,
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:markdownViewer.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownViewer.open",
        "title": "Markdown Viewer で開く",
        "icon": "$(book)"
      },
      {
        "command": "markdownViewer.openToSide",
        "title": "Markdown Viewer でもう 1 つ開く",
        "icon": "$(book)"
      },
      {
        "command": "markdownViewer.copyComments",
        "title": "コメントを箇条書きでコピー",
        "category": "Markdown Viewer"
      },
      {
        "command": "markdownViewer.clearComments",
        "title": "コメントをすべて削除",
        "category": "Markdown Viewer"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownViewer.open",
          "when": "editorLangId == markdown",
          "alt": "markdownViewer.openToSide",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownViewer.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "markdownViewer.editor",
        "displayName": "Markdown Viewer",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Markdown Viewer",
      "properties": {
        "markdownViewer.styles": {
          "type": "object",
          "default": {},
          "markdownDescription": "プレビューのスタイルを要素ごとに指定します。要素は `document`, `h1`, `h2`, `h3`, `h4`, `h5`, `h6`, `paragraph`, `list`, `listItem`, `blockquote`, `inlineCode`, `codeBlock`, `table`, `tableHeader`, `tableCell`, `hr`, `link`, `bold`, `italic` です。例: `{ \"h1\": { \"color\": \"#ff8800\", \"fontSize\": 32 }, \"paragraph\": { \"lineHeight\": 2 } }`",
          "propertyNames": {
            "enum": [
              "document",
              "h1",
              "h2",
              "h3",
              "h4",
              "h5",
              "h6",
              "paragraph",
              "list",
              "listItem",
              "blockquote",
              "inlineCode",
              "codeBlock",
              "table",
              "tableHeader",
              "tableCell",
              "hr",
              "link",
              "bold",
              "italic"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "color": {
                "type": "string",
                "description": "文字色（水平線は線の色）。例: #ff8800"
              },
              "backgroundColor": {
                "type": "string",
                "description": "背景色"
              },
              "fontFamily": {
                "type": "string",
                "description": "フォント。例: Hiragino Sans, sans-serif"
              },
              "fontSize": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "文字サイズ。数値は px。例: 24, 1.5em"
              },
              "fontWeight": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "太さ。例: 700, bold"
              },
              "fontStyle": {
                "type": "string",
                "description": "斜体など。例: italic"
              },
              "lineHeight": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "行間。数値は文字サイズの倍率。例: 1.8"
              },
              "letterSpacing": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "文字の間隔。数値は px"
              },
              "textDecoration": {
                "type": "string",
                "description": "下線など。例: underline, none"
              },
              "marginTop": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "上の余白。数値は px"
              },
              "marginBottom": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "下の余白。数値は px"
              },
              "borderColor": {
                "type": "string",
                "description": "枠線の色（見出しの下線、引用の線、表の罫線）"
              }
            }
          }
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "markdownViewerComments",
          "title": "コメント",
          "icon": "$(comment)"
        }
      ]
    },
    "views": {
      "markdownViewerComments": [
        {
          "id": "markdownViewer.comments",
          "type": "webview",
          "name": "コメント",
          "icon": "$(comment)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.mjs",
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "compile-tests": "tsc -p . --outDir out",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "vscode-test",
    "vsix": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/vscode": "~1.144.0"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3"
  }
}
